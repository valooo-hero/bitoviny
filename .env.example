# Skopíruj do .env a doplň. Súbor .env sa do repozitára nedostane.
# V produkcii sú hodnoty v GitHub Secrets a v nastaveniach Cloudflare Pages.

GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Platená posledná záloha, nepovinné. Kľúč: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
