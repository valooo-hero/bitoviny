---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Karta from '../../components/Karta.astro';
import { sekcia } from '../../data/sekcie';
import { redaktor } from '../../data/redakcia';
import { vsetkyClanky, stiahnuteClanky, datumCas, datum, slug } from '../../lib/clanky';
import { statistikaClanku, percento, sklon } from '../../lib/statistiky';

export async function getStaticPaths() {
  const clanky = await vsetkyClanky();
  return [
    ...clanky.map((clanok) => ({ params: { id: clanok.id }, props: { clanok, clanky, stiahnuty: false } })),
    // Stiahnutý článok dostane na svojej adrese len oznam, bez obsahu.
    ...(await stiahnuteClanky()).map((clanok) => ({ params: { id: clanok.id }, props: { clanok, clanky, stiahnuty: true } })),
  ];
}

const { clanok, clanky, stiahnuty } = Astro.props;
const d = clanok.data;
const { Content } = await render(clanok);
const s = sekcia(d.sekcia);

const meno = (id: string) => redaktor(id)?.meno ?? id;
const st = statistikaClanku(clanok);
const suvisiace = clanky
  .filter((c) => c.id !== clanok.id)
  .map((c) => ({
    c,
    skore: (c.data.sekcia === d.sekcia ? 2 : 0) + c.data.tagy.filter((t) => d.tagy.includes(t)).length,
  }))
  .sort((a, b) => b.skore - a.skore)
  .slice(0, 3)
  .map((x) => x.c);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.title,
  description: d.perex,
  datePublished: d.publikovane.toISOString(),
  dateModified: (d.aktualizovane ?? d.publikovane).toISOString(),
  image: [new URL(d.obrazok.src, Astro.site).href],
  articleSection: s.nazov,
  inLanguage: 'sk',
  author: { '@type': 'Organization', name: 'Redakcia Bitoviny', url: new URL('/redakcia/', Astro.site).href },
  publisher: { '@type': 'Organization', name: 'Bitoviny' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

{
  stiahnuty && (
    <Base title="Článok bol stiahnutý" description="Tento článok redakcia stiahla zo zverejnenia." noindex>
      <article class="clanok proza">
        <h1>Článok bol stiahnutý</h1>
        <p>Tento článok redakcia stiahla zo zverejnenia.</p>
        <p>
          <a href="/">Späť na titulku</a>
        </p>
      </article>
    </Base>
  )
}

{
  !stiahnuty && (
<Base title={d.title} description={d.perex} image={d.obrazok.src} typ="article" aktivnaSekcia={d.sekcia} jsonLd={jsonLd}>
  <article class="clanok" data-pagefind-body>
    <a class="stitok" href={`/sekcia/${d.sekcia}/`}>{s.nazov}</a>
    <h1>{d.title}</h1>
    <p class="perex">{d.perex}</p>

    <div class="podpis meta" data-pagefind-ignore>
      <time datetime={d.publikovane.toISOString()}>{datumCas(d.publikovane)}</time>
      {d.aktualizovane && <span>Aktualizované {datumCas(d.aktualizovane)}</span>}
      {
        d.redaktori ? (
          <span>
            Napísal(a) {meno(d.redaktori.autor)}, overil(a) {meno(d.redaktori.factcheck)}, korektúra{' '}
            {meno(d.redaktori.korektura)}
            {d.redaktori.schvalil ? `, schválil(a) ${meno(d.redaktori.schvalil)}` : ', čaká na schválenie'}
          </span>
        ) : (
          <span>Redakcia Bitoviny</span>
        )
      }
      <a class="ai-oznacenie" href="/ako-to-funguje/">
        {
          d.vzorovy
            ? 'Vzorový článok, napísala AI'
            : d.redaktori?.schvalil
              ? 'Pripravené AI, schválené redaktorom'
              : 'Koncept, pripravené AI'
        }
      </a>
    </div>

    {
      d.vzorovy && (
        <p class="upozornenie" data-pagefind-ignore>
          Tento článok vznikol pri vývoji portálu ako ukážka vzhľadu. Napísala ho AI na pokyn vývojára, neprešiel
          redakčnou pipeline.
        </p>
      )
    }

    <figure>
      <img src={d.obrazok.src} alt={d.obrazok.alt} width="1200" height="675" />
      <figcaption>
        {d.obrazok.popisok}
        {' '}Zdroj: {d.obrazok.kredit}. Licencia: {d.obrazok.licencia}.
        {d.obrazok.ai && !/AI/.test(d.obrazok.licencia) && ' Vytvorené AI.'}
      </figcaption>
    </figure>

    <div class="proza">
      <Content />
    </div>

    {
      d.galeria.length > 0 && (
        <div class="galeria-clanku" data-pagefind-ignore>
          {d.galeria.map((o) => (
            <figure>
              <img src={o.src} alt={o.alt} loading="lazy" />
              <figcaption>
                {o.popisok}
                {' '}Zdroj: {o.kredit}. Licencia: {o.licencia}.
                {o.ai && !/AI/.test(o.licencia) && ' Vytvorené AI.'}
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }

    <footer class="pata-clanku" data-pagefind-ignore>
      {
        d.opravy.length > 0 && (
          <>
            <h2>Opravy</h2>
            <ul>
              {d.opravy.map((o) => (
                <li>
                  {datum(o.datum)}: {o.text}
                </li>
              ))}
            </ul>
          </>
        )
      }
      <h2>Zdroje</h2>
      <ul>
        {
          d.zdroje.map((z) => (
            <li>
              <a href={z.url} rel="noopener">
                {z.nazov}
              </a>
            </li>
          ))
        }
      </ul>
      {
        st.tvrdeni !== null && (
          <details class="vznik">
            <summary>Ako vznikol tento článok</summary>
            <ul>
              <li>
                Tému vybral Róbert S. Sliedič, článok napísala Klára Vesnicová z {sklon(st.zdrojov, 'zdroja', 'zdrojov', 'zdrojov')}
                ({sklon(st.slovAgentov ?? st.slovZverejnenych, 'slovo', 'slová', 'slov')}).
              </li>
              <li>
                Tomáš Neverný overil {sklon(st.tvrdeni ?? 0, 'tvrdenie', 'tvrdenia', 'tvrdení')} voči zdrojom
                {(st.kolFactchecku ?? 0) > 1
                  ? `, v prvom kole našiel ${sklon(st.chybVPrvomKole ?? 0, 'chybu', 'chyby', 'chýb')} a vrátil článok na opravu`
                  : ' a nenašiel chybu'}
                {(st.otvorenychNalezov ?? 0) > 0 ? `. ${st.otvorenychNalezov} nález ostal na posúdenie šéfredaktorovi.` : '.'}
              </li>
              <li>
                Čiarka Ypsilonová {st.upravVykonanych ? `vykonala ${sklon(st.upravVykonanych, 'jazykovú opravu', 'jazykové opravy', 'jazykových opráv')}.` : 'nenavrhla žiadnu jazykovú opravu.'}
              </li>
              <li>
                Cyril Kopirajt posúdil {sklon(st.obrazkovZoZdrojov, 'obrázok', 'obrázky', 'obrázkov')} zo zdrojov, použiť sa
                {st.obrazkovChranenych === st.obrazkovZoZdrojov ? 'nedal žiadny' : `nedalo ${st.obrazkovChranenych}`}.
              </li>
              <li>
                Šéfredaktor článok schválil
                {st.zasahEditora === null ? '.' : st.zasahEditora < 0.005 ? ' bez zmeny textu.' : ` a zmenil ${percento(st.zasahEditora)} textu.`}
              </li>
            </ul>
            <p class="meta">
              Ako redakcia pracuje, opisuje stránka <a href="/ako-to-funguje/">Ako to funguje</a>.
            </p>
          </details>
        )
      }
      {
        d.tagy.length > 0 && (
          <>
            <h2>Tagy</h2>
            <ul class="tagy">
              {d.tagy.map((t) => (
                <li>
                  <a href={`/tag/${slug(t)}/`}>{t}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </footer>
  </article>

  {
    suvisiace.length > 0 && (
      <section>
        <h2 class="nadpis-bloku">Súvisiace články</h2>
        <div class="mriezka">
          {suvisiace.map((c) => (
            <Karta clanok={c} />
          ))}
        </div>
      </section>
    )
  }
</Base>
  )
}
