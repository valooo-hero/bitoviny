---
import Base from '../../layouts/Base.astro';
---

<Base title="Redakčné rozhranie" noindex>
  <div id="admin" data-pagefind-ignore>
    <div class="admin-hlava">
      <h1>Redakčné rozhranie</h1>
      <div id="prihlaseny" class="riadok" hidden>
        <span class="meta">Prihlásený: <strong id="kto"></strong></span>
        <button id="obnovit" class="tl" type="button">Obnoviť zoznam</button>
        <button id="odhlasit" class="tl" type="button">Odhlásiť</button>
      </div>
    </div>
    <p id="hlasenie" class="hlasenie" role="status" aria-live="polite" hidden></p>

    <section id="prihlasenie" hidden>
      <p>Do redakcie sa prihlasuje účtom GitHub. Prístup má len šéfredaktor.</p>
      <p><a class="tl hlavne" href="/api/auth/login" style="display:inline-block;text-decoration:none">Prihlásiť cez GitHub</a></p>
    </section>

    <div id="redakcia-obsah" hidden>
    <section id="zoznam">
      <h2 class="nadpis-bloku">Koncepty na schválenie</h2>
      <div id="zoznam-koncepty"><p class="meta">Načítavam koncepty…</p></div>
      <h2 class="nadpis-bloku">Zverejnené články</h2>
      <p class="meta">Zoznam sa po zmene aktualizuje až po zostavení webu, zhruba o minútu.</p>
      <div id="zoznam-zverejnene"><p class="meta">Načítavam články…</p></div>
    </section>

    <section id="detail" hidden>
      <button id="spat" class="tl" type="button">← Späť na zoznam</button>

      <div class="karty" role="tablist">
        <button class="karta-tl" role="tab" data-karta="clanok" aria-selected="true">Článok</button>
        <button class="karta-tl" role="tab" data-karta="obrazok" aria-selected="false">Obrázok</button>
        <button class="karta-tl" role="tab" data-karta="factcheck" aria-selected="false">Factcheck</button>
        <button class="karta-tl" role="tab" data-karta="korektura" aria-selected="false">Korektúra</button>
      </div>

      <div class="panel" data-panel="clanok">
        <div class="dvojstlpec">
          <form id="form-text">
            <label>Titulok <span class="pocet" data-pre="titulok"></span>
              <input id="titulok" name="titulok" maxlength="110" required />
            </label>
            <label>Perex <span class="pocet" data-pre="perex"></span>
              <textarea id="perex" name="perex" rows="3" maxlength="320" required></textarea>
            </label>
            <label>Telo článku (Markdown)
              <textarea id="telo" name="telo" rows="22" required></textarea>
            </label>
            <label>Sekcia
              <select id="sekcia">
                <option value="ai">AI</option>
                <option value="bezpecnost">Bezpečnosť</option>
                <option value="hardver">Hardvér</option>
                <option value="mobil">Mobil</option>
                <option value="softver">Softvér a vývoj</option>
                <option value="veda">Veda a vesmír</option>
                <option value="biznis">Biznis</option>
                <option value="slovensko-eu">Slovensko a EÚ</option>
              </select>
            </label>
            <label>Tagy (oddelené čiarkou)
              <input id="tagy" maxlength="300" />
            </label>
            <label>Zdroje (jeden na riadok v tvare: Názov | adresa)
              <textarea id="zdroje" rows="4" required placeholder="Ars Technica: Titulok článku | https://arstechnica.com/..."></textarea>
            </label>
            <label id="oprava-obal" hidden>Poznámka k oprave (nepovinná, zobrazí sa pod článkom a na stránke Opravy)
              <input id="oprava" maxlength="500" placeholder="napr. Opravili sme počet serverov z 450 na 145." />
            </label>
            <button id="ulozit-text" class="tl hlavne" type="submit">Uložiť</button>
          </form>
          <div>
            <h2 class="nadpis-bloku">Náhľad</h2>
            <article class="clanok">
              <h1 id="nahlad-titulok"></h1>
              <p class="perex" id="nahlad-perex"></p>
              <div class="proza" id="nahlad-telo"></div>
            </article>
            <h2 class="nadpis-bloku">Poznámky od agentov</h2>
            <div id="poznamky" class="poznamky"></div>
          </div>
        </div>
      </div>

      <div class="panel" data-panel="obrazok" hidden>
        <h2 class="nadpis-bloku">Aktuálny obrázok</h2>
        <figure id="aktualny"></figure>

        <h2 class="nadpis-bloku">Obrázky zo zdrojov</h2>
        <p class="meta">Zaradenie je automatické odporúčanie. Stav môžete zmeniť podľa vlastného úsudku, zmena sa zapíše do redakčnej správy aj s dôvodom.</p>
        <div id="povodne" class="galeria"></div>

        <h2 class="nadpis-bloku">Vymeniť obrázok: voľné náhrady</h2>
        <p class="meta">Pred použitím otvorte stránku pôvodu a overte licenciu. Logá môžu byť chránené ako ochranná známka.</p>
        <div id="alternativy" class="galeria"></div>

        <h2 class="nadpis-bloku">Vygenerovať obrázok</h2>
        <div id="generator">
          <button id="gen-ukaz" class="tl" type="button">Vygenerovať obrázok…</button>
          <div id="gen-krok2" hidden>
            <label>Prompt, ktorý sa odošle modelu FLUX.1-schnell (dá sa upraviť)
              <textarea id="gen-prompt" rows="4" maxlength="1500"></textarea>
            </label>
            <label>Popisok pod obrázkom
              <input id="gen-popisok" maxlength="300" value="Ilustračný obrázok." />
            </label>
            <div class="riadok">
              <button id="gen-odoslat" class="tl hlavne" type="button">Odoslať</button>
              <button id="gen-zrusit" class="tl" type="button">Zrušiť</button>
            </div>
          </div>
          <div id="gen-vysledok" hidden>
            <img id="gen-obrazok" alt="Vygenerovaný náhľad" width="1024" height="1024" />
            <div class="riadok">
              <button id="gen-pouzit" class="tl hlavne" type="button">Použiť</button>
              <button id="gen-znova" class="tl" type="button">Skúsiť znova</button>
              <button id="gen-zahodit" class="tl" type="button">Zahodiť</button>
            </div>
          </div>
        </div>
      </div>

      <div class="panel" data-panel="factcheck" hidden>
        <div id="fc-suhrn"></div>
        <h2 class="nadpis-bloku">Neuzavreté nálezy</h2>
        <div id="fc-nalezy"></div>
        <h2 class="nadpis-bloku">Všetky tvrdenia</h2>
        <div class="tabulka-obal"><table id="fc-tvrdenia"></table></div>
      </div>

      <div class="panel" data-panel="korektura" hidden>
        <div id="kor-upravy"></div>
        <h2 class="nadpis-bloku">Diff</h2>
        <pre id="kor-diff" class="diff"></pre>
      </div>

      <div class="zverejnenie" id="blok-zverejneny" hidden>
        <p id="stav-zverejnenia"></p>
        <div class="riadok">
          <button id="stiahnut" class="tl nebezpecne" type="button">Stiahnuť zo zverejnenia</button>
          <button id="vratit" class="tl hlavne" type="button">Vrátiť na web</button>
          <a id="clanok-odkaz" class="meta" target="_blank" rel="noopener">Otvoriť článok na webe</a>
        </div>
        <p class="meta">Stiahnutý článok ostáva v repozitári a dá sa vrátiť. Jeho obrázok a história úprav ostávajú verejne dostupné na GitHube.</p>
      </div>

      <div class="zverejnenie" id="blok-koncept">
        <ul id="prekazky"></ul>
        <label class="potvrdenie">
          <input type="checkbox" id="potvrdenie" />
          Článok som prečítal, skontroloval fakty, obrázok aj licenciu a zodpovedám za jeho zverejnenie.
        </label>
        <div class="riadok">
          <button id="zverejnit" class="tl hlavne" type="button" disabled>Zverejniť</button>
          <button id="zahodit" class="tl nebezpecne" type="button">Zahodiť koncept</button>
          <a id="pr-odkaz" class="meta" target="_blank" rel="noopener">Pull request na GitHube</a>
        </div>
      </div>
    </section>
    </div>

    <dialog id="dlg-pouzit">
      <form id="form-pouzit">
        <h2>Použiť obrázok</h2>
        <p id="pouzit-prava" class="meta"></p>
        <label>Popisok pod obrázkom (po slovensky)
          <textarea id="pouzit-popisok" rows="3" minlength="5" maxlength="300" required></textarea>
        </label>
        <p class="dlg-chyba" role="alert"></p>
        <div class="riadok">
          <button id="pouzit-ulozit" class="tl hlavne" type="submit">Použiť obrázok</button>
          <button class="tl dlg-zrusit" type="button">Zrušiť</button>
        </div>
      </form>
    </dialog>

    <dialog id="dlg-prava">
      <form id="form-prava">
        <h2>Zmeniť stav obrázka</h2>
        <p id="prava-auto" class="meta"></p>
        <label>Stav
          <select id="prava-zaradenie">
            <option value="volne">voľné: smie sa použiť (voľná licencia)</option>
            <option value="tlacove">tlačové: smie sa použiť (tlačový materiál, súhlas autora)</option>
            <option value="nejasne">nejasné: nepoužiť</option>
            <option value="chranene">chránené: nepoužiť</option>
          </select>
        </label>
        <label>Autor alebo zdroj (zobrazí sa pod obrázkom)
          <input id="prava-kredit" maxlength="150" />
        </label>
        <label>Licencia alebo právny základ (zobrazí sa pod obrázkom)
          <input id="prava-licencia" maxlength="80" placeholder="napr. tlačový materiál, CC BY 4.0, so súhlasom autora" />
        </label>
        <label>Dôvod rozhodnutia (ostane v redakčnej správe)
          <textarea id="prava-dovod" rows="3" maxlength="500" placeholder="napr. Obrázok je z oficiálnej tlačovej správy výrobcu."></textarea>
        </label>
        <p class="dlg-chyba" role="alert"></p>
        <div class="riadok">
          <button id="prava-ulozit" class="tl hlavne" type="submit">Uložiť stav</button>
          <button class="tl dlg-zrusit" type="button">Zrušiť</button>
        </div>
      </form>
    </dialog>
  </div>
</Base>

<style is:global>
  #admin { --ok: #0a7d5a; --zle: #c0392b; --pozor: #b7791f; }
  #admin dialog { width: min(560px, calc(100vw - 32px)); border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--text); padding: 20px; }
  #admin dialog::backdrop { background: rgb(0 0 0 / 0.6); }
  #admin dialog h2 { font-size: 1.3rem; margin-bottom: 10px; }
  #admin select { display: block; width: 100%; margin-top: 6px; padding: 10px; font: inherit; font-weight: 400; color: var(--text); background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
  .dlg-chyba { color: var(--zle); font-size: 0.9rem; margin: 0; }
  .dlg-chyba:empty { display: none; }
  /* Atribút hidden musí vyhrať aj nad pravidlami s display: flex či grid. */
  #admin [hidden] { display: none !important; }
  .admin-hlava { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  #admin .tl { font: inherit; padding: 8px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--text); cursor: pointer; }
  #admin .tl:hover:not(:disabled) { border-color: var(--accent); }
  #admin .tl:disabled { opacity: 0.5; cursor: not-allowed; }
  #admin .tl.hlavne { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 600; }
  #admin .tl.nebezpecne { color: var(--zle); }
  .hlasenie { padding: 10px 14px; border-radius: 6px; background: var(--warn-bg); color: var(--warn-text); }
  .hlasenie.chyba { background: color-mix(in srgb, var(--zle) 15%, var(--surface)); color: var(--text); border: 1px solid var(--zle); }
  .koncept-riadok { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .koncept-riadok button { font-family: var(--serif); font-size: 1.15rem; font-weight: 700; background: none; border: 0; color: inherit; text-align: left; cursor: pointer; padding: 0; }
  .koncept-riadok button:hover { color: var(--accent); }
  .karty { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin: 16px 0; overflow-x: auto; }
  .karta-tl { font: inherit; font-weight: 600; padding: 10px 14px; background: none; border: 0; border-bottom: 2px solid transparent; color: var(--muted); cursor: pointer; white-space: nowrap; }
  .karta-tl[aria-selected='true'] { color: var(--accent); border-bottom-color: var(--accent); }
  .dvojstlpec { display: grid; gap: 28px; }
  @media (min-width: 1000px) { .dvojstlpec { grid-template-columns: 1fr 1fr; } }
  #admin label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 14px; }
  #admin input:not([type='checkbox']), #admin textarea { display: block; width: 100%; margin-top: 6px; padding: 10px; font: inherit; font-weight: 400; color: var(--text); background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
  #admin textarea#telo { font-family: var(--mono); font-size: 0.9rem; line-height: 1.5; }
  .pocet { font-weight: 400; color: var(--muted); }
  .pocet.zle { color: var(--zle); }
  .poznamky { font-size: 0.95rem; }
  .poznamky p { margin: 0 0 10px; }
  .galeria { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .obr-karta { border: 1px solid var(--line); border-radius: 8px; padding: 10px; background: var(--surface); font-size: 0.85rem; display: flex; flex-direction: column; gap: 6px; }
  .obr-karta img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 4px; background: var(--line); }
  .obr-karta.chranene, .obr-karta.nejasne { border-color: var(--zle); }
  .znacka { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; color: #fff; }
  .znacka.volne, .znacka.potvrdene, .znacka.vykonana { background: var(--ok); }
  .znacka.tlacove, .znacka.nepresne, .znacka.nenajdena, .znacka.upozornenie { background: var(--pozor); }
  .znacka.chranene, .znacka.nejasne, .znacka.nepodlozene, .znacka.v_rozpore, .znacka.zamietnuta, .znacka.chyba { background: var(--zle); }
  #aktualny img, #gen-obrazok { max-width: 520px; width: 100%; border-radius: 6px; height: auto; }
  .riadok { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 10px; }
  .tabulka-obal { overflow-x: auto; }
  #fc-tvrdenia { border-collapse: collapse; font-size: 0.85rem; width: 100%; min-width: 760px; }
  #fc-tvrdenia th, #fc-tvrdenia td { text-align: left; vertical-align: top; padding: 8px; border-bottom: 1px solid var(--line); }
  .nalez { border-left: 3px solid var(--zle); padding: 6px 12px; margin-bottom: 10px; font-size: 0.95rem; }
  .nalez.upozornenie { border-left-color: var(--pozor); }
  .diff { font-family: var(--mono); font-size: 0.85rem; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 12px; overflow-x: auto; white-space: pre-wrap; }
  .diff .plus { color: var(--ok); }
  .diff .minus { color: var(--zle); }
  .zverejnenie { margin-top: 32px; padding: 18px; border: 2px solid var(--line); border-radius: 10px; background: var(--surface); }
  #prekazky { margin: 0 0 12px; padding-left: 20px; color: var(--zle); font-size: 0.95rem; }
  #prekazky:empty { display: none; }
  #admin label.potvrdenie { font-weight: 400; font-size: 0.95rem; display: flex; gap: 10px; align-items: flex-start; }
</style>

<script>
  import { marked } from 'marked';

  const $ = (id: string) => document.getElementById(id)!;
  const el = (tag: string, vlastnosti: Record<string, any> = {}, ...deti: (Node | string)[]) => {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(vlastnosti)) {
      if (k === 'class') e.className = v;
      else if (k.startsWith('on')) e.addEventListener(k.slice(2), v);
      else if (v !== undefined && v !== false) e.setAttribute(k, String(v));
    }
    e.append(...deti);
    return e;
  };
  // Text od modelov a z cudzích webov sa do stránky vkladá len ako text, nikdy ako HTML.
  const bezHtml = (t: string) =>
    String(t ?? '')
      .replace(/<\/?[a-zA-Z!][^>]{0,500}>/g, '')
      .replace(/\]\(\s*(?!https?:|mailto:|\/|#)(?:[^()]|\([^()]*\))*\)/gi, ']()');
  const md = (t: string) => marked.parse(bezHtml(t), { async: false }) as string;

  let stav: any = null; // otvorený koncept
  let vygenerovany: string | null = null;

  function hlas(text: string, chyba = false) {
    const h = $('hlasenie');
    h.textContent = text;
    h.classList.toggle('chyba', chyba);
    h.hidden = !text;
    if (text) h.scrollIntoView({ block: 'nearest' });
  }

  async function api(cesta: string, metoda = 'GET', telo?: unknown) {
    const r = await fetch(cesta, {
      method: metoda,
      headers: telo ? { 'Content-Type': 'application/json' } : undefined,
      body: telo ? JSON.stringify(telo) : undefined,
    });
    const data = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(data.chyba || `Chyba ${r.status}`);
    return data;
  }

  async function pracuj(tlacidlo: HTMLButtonElement | null, popis: string, fn: () => Promise<void>) {
    const povodny = tlacidlo?.textContent;
    if (tlacidlo) { tlacidlo.disabled = true; tlacidlo.textContent = popis; }
    hlas('');
    try { await fn(); } catch (e: any) { hlas(e.message, true); } finally {
      if (tlacidlo) { tlacidlo.disabled = false; tlacidlo.textContent = povodny!; }
      aktualizujPrekazky();
    }
  }

  // ---------- zoznam ----------

  async function nacitajZoznam() {
    const z = $('zoznam-koncepty');
    z.replaceChildren(el('p', { class: 'meta' }, 'Načítavam koncepty…'));
    try {
      const { koncepty } = await api('/api/koncepty');
      if (!koncepty.length) z.replaceChildren(el('p', {}, 'Žiadny koncept nečaká na schválenie.'));
      else z.replaceChildren(
        ...koncepty.map((k: any) =>
          el('div', { class: 'koncept-riadok' },
            el('button', { type: 'button', onclick: () => otvor(k.pr) }, k.titulok),
            el('span', { class: 'meta' }, new Date(k.vytvorene).toLocaleString('sk-SK')),
          ),
        ),
      );
    } catch (e: any) {
      z.replaceChildren();
      hlas(e.message, true);
    }
    nacitajZverejnene();
  }

  // Zoznam článkov vzniká pri zostavení webu (statický súbor), preto je bez volania API.
  async function nacitajZverejnene() {
    const z = $('zoznam-zverejnene');
    try {
      const { clanky } = await fetch(`/admin/clanky.json?t=${Date.now()}`).then((r) => r.json());
      z.replaceChildren(
        ...clanky.map((c: any) =>
          el('div', { class: 'koncept-riadok' },
            el('button', { type: 'button', onclick: () => otvorZverejneny(c.slug) }, c.titulok),
            el('span', { class: 'meta' },
              c.stiahnute ? el('span', { class: 'znacka chranene' }, 'stiahnuté') : '',
              c.vzorovy ? el('span', { class: 'znacka upozornenie' }, 'vzorový') : '',
              ` ${new Date(c.publikovane).toLocaleDateString('sk-SK')}`,
            ),
          ),
        ),
      );
    } catch {
      z.replaceChildren(el('p', { class: 'meta' }, 'Zoznam článkov sa nepodarilo načítať.'));
    }
  }

  // ---------- detail ----------

  // Koncept sa číta a zapisuje cez pull request, zverejnený článok priamo vo vetve main.
  const adresa = () => (stav.zverejneny ? `/api/clanok/${stav.slug}` : `/api/koncept/${stav.pr}`);

  async function otvorDetail(cesta: string, hash: string) {
    hlas('Načítavam…');
    try {
      stav = await api(cesta);
    } catch (e: any) {
      return hlas(e.message, true);
    }
    hlas('');
    $('zoznam').hidden = true;
    $('detail').hidden = false;
    ($('potvrdenie') as HTMLInputElement).checked = false;
    vygenerovany = null;
    $('gen-krok2').hidden = $('gen-vysledok').hidden = true;
    vykresli();
    prepniKartu('clanok');
    history.replaceState(null, '', hash);
  }
  const otvor = (pr: number) => otvorDetail(`/api/koncept/${pr}`, `#${pr}`);
  const otvorZverejneny = (slug: string) => otvorDetail(`/api/clanok/${slug}`, `#clanok/${slug}`);

  const zdrojeNaText = (zdroje: any[]) => (zdroje ?? []).map((z) => `${z.nazov} | ${z.url}`).join('\n');
  function zdrojeZTextu(text: string) {
    return text.split('\n').map((r) => r.trim()).filter(Boolean).map((r) => {
      const i = r.lastIndexOf('|');
      return i < 0 ? { nazov: '', url: r } : { nazov: r.slice(0, i).trim(), url: r.slice(i + 1).trim() };
    });
  }
  const hodnota = (id: string) => ($(id) as HTMLInputElement).value;
  // Odtlačok formulára: podľa neho sa pozná, či sú v ňom neuložené zmeny.
  const odtlacok = () => JSON.stringify(['titulok', 'perex', 'telo', 'sekcia', 'tagy', 'zdroje'].map((id) => hodnota(id).trim()));
  let ulozenyOdtlacok = '';

  function vykresli() {
    const { hlavicka, telo, sprava } = stav;
    ($('titulok') as HTMLInputElement).value = hlavicka.title;
    ($('perex') as HTMLTextAreaElement).value = hlavicka.perex;
    ($('telo') as HTMLTextAreaElement).value = telo;
    ($('sekcia') as HTMLSelectElement).value = hlavicka.sekcia;
    ($('tagy') as HTMLInputElement).value = (hlavicka.tagy ?? []).join(', ');
    ($('zdroje') as HTMLTextAreaElement).value = zdrojeNaText(hlavicka.zdroje);
    ($('oprava') as HTMLInputElement).value = '';
    ulozenyOdtlacok = odtlacok();

    // Zverejnený článok: úpravy idú rovno na web, obrázok a redakčná správa sa tu nemenia.
    const zv = Boolean(stav.zverejneny);
    $('oprava-obal').hidden = !zv;
    $('blok-koncept').hidden = zv;
    $('blok-zverejneny').hidden = !zv;
    $('ulozit-text').textContent = zv ? 'Uložiť zmeny na web' : 'Uložiť';
    document.querySelectorAll<HTMLElement>('.karta-tl').forEach((t) => (t.hidden = zv && t.dataset.karta !== 'clanok'));
    if (zv) {
      const stiahnute = hlavicka.stiahnute === true;
      $('stav-zverejnenia').textContent = stiahnute ? 'Článok je stiahnutý zo zverejnenia. Na webe sa nezobrazuje.' : 'Článok je zverejnený.';
      $('stiahnut').hidden = stiahnute;
      $('vratit').hidden = !stiahnute;
      ($('clanok-odkaz') as HTMLAnchorElement).href = `/clanok/${stav.slug}/`;
      $('clanok-odkaz').hidden = stiahnute;
    } else {
      ($('pr-odkaz') as HTMLAnchorElement).href = stav.prUrl;
    }
    nahlad();
    vykresliPoznamky(sprava);
    vykresliObrazky();
    vykresliFactcheck(sprava?.factcheck);
    vykresliKorekturu(sprava?.korektura);
    aktualizujPrekazky();
  }

  function nahlad() {
    const t = ($('titulok') as HTMLInputElement).value, p = ($('perex') as HTMLTextAreaElement).value;
    $('nahlad-titulok').textContent = t;
    $('nahlad-perex').textContent = p;
    $('nahlad-telo').innerHTML = md(($('telo') as HTMLTextAreaElement).value);
    for (const [pole, dlzka, min, max] of [['titulok', t.length, 10, 110], ['perex', p.length, 40, 320]] as const) {
      const s = document.querySelector(`.pocet[data-pre="${pole}"]`)!;
      s.textContent = `${dlzka} / ${max}`;
      s.classList.toggle('zle', dlzka < min || dlzka > max);
    }
  }

  function vykresliPoznamky(s: any) {
    const p = $('poznamky');
    p.replaceChildren();
    if (!s) return p.append(el('p', { class: 'meta' }, 'Koncept nemá redakčnú správu.'));
    if (s.dovod_vyberu) p.append(el('p', {}, el('strong', {}, 'Prečo táto téma: '), s.dovod_vyberu));
    if (s.poznamky_pre_editora) p.append(el('p', {}, el('strong', {}, 'Autorka: '), s.poznamky_pre_editora));
    for (const u of s.upozornenia ?? []) p.append(el('p', {}, el('span', { class: 'znacka upozornenie' }, 'upozornenie'), ' ', u));
    p.append(el('p', { class: 'meta' }, 'Zdroje: ', ...stav.hlavicka.zdroje.flatMap((z: any, i: number) => [i ? ', ' : '', el('a', { href: z.url, target: '_blank', rel: 'noopener' }, z.nazov.slice(0, 60))])));
  }

  // ---------- obrázky ----------

  function vykresliObrazky() {
    const o = stav.hlavicka.obrazok, s = stav.sprava?.obrazky;
    $('aktualny').replaceChildren(
      el('img', { src: stav.obrazokUrl, alt: o.alt }),
      el('figcaption', {}, `${o.popisok} Zdroj: ${o.kredit}. Licencia: ${o.licencia}.`, stav.cakaNaObrazok ? ' Treba vybrať obrázok.' : ''),
    );

    $('povodne').replaceChildren(
      ...(s?.povodne ?? []).map((p: any) => {
        const pouzitelny = p.zaradenie === 'volne' || p.zaradenie === 'tlacove';
        return el('div', { class: `obr-karta ${p.zaradenie}` },
          el('img', { src: p.url, alt: p.alt || '', loading: 'lazy', referrerpolicy: 'no-referrer' }),
          el('div', {}, el('span', { class: `znacka ${p.zaradenie}` }, p.zaradenie), ` ${p.zdroj_clanku}`),
          el('div', {}, p.dovod),
          p.kredit ? el('div', { class: 'meta' }, `Kredit: ${p.kredit}`) : '',
          p.licencia ? el('div', { class: 'meta' }, `Licencia: ${p.licencia}`) : '',
          p.automaticke_zaradenie ? el('div', { class: 'meta' }, `Pôvodné automatické zaradenie: ${p.automaticke_zaradenie}`) : '',
          el('button', { class: 'tl', type: 'button', onclick: () => otvorPrava(p) }, 'Zmeniť stav'),
          pouzitelny ? el('button', { class: 'tl hlavne', type: 'button', onclick: () => otvorPouzitie(p.url, p.popisok || p.alt, p.kredit || p.zdroj_clanku, p.licencia || (p.zaradenie === 'tlacove' ? 'tlačový materiál' : 'voľná licencia')) }, 'Použiť') : '',
        );
      }),
    );
    if (!s?.povodne?.length) $('povodne').append(el('p', { class: 'meta' }, 'Zdroje neobsahovali žiadne obrázky.'));

    $('alternativy').replaceChildren(
      ...(s?.alternativy ?? []).map((a: any) =>
        el('div', { class: 'obr-karta' },
          // Náhľady z Openverse občas nefungujú, vtedy sa skúsi plný obrázok.
          el('img', { src: a.nahlad || a.url, alt: a.nazov, loading: 'lazy', referrerpolicy: 'no-referrer', onerror: (e: Event) => { const i = e.currentTarget as HTMLImageElement; if (i.src !== a.url) i.src = a.url; } }),
          el('div', {}, el('span', { class: 'znacka volne' }, a.licencia), ` ${a.povod}`),
          el('div', {}, a.nazov.slice(0, 80)),
          el('div', { class: 'meta' }, `Autor: ${a.autor || 'neuvedený'}`),
          el('a', { href: a.stranka, target: '_blank', rel: 'noopener' }, 'Stránka pôvodu a licencia'),
          el('button', { class: 'tl', type: 'button', onclick: () => otvorPouzitie(a.url, a.nazov, [a.autor, a.povod === 'wikimedia' ? 'Wikimedia Commons' : 'Openverse'].filter(Boolean).join(' / '), a.licencia) }, 'Použiť'),
        ),
      ),
    );
    if (!s?.alternativy?.length) $('alternativy').append(el('p', { class: 'meta' }, 'Nenašli sa žiadne voľné náhrady.'));
  }

  // Použitie obrázka: popisok sa zadáva vo formulári, kredit a licencia sa len ukážu.
  let pouzivanaUrl = '';
  function otvorPouzitie(url: string, navrhPopisku: string, kredit: string, licencia: string) {
    pouzivanaUrl = url;
    ($('pouzit-popisok') as HTMLTextAreaElement).value = (navrhPopisku || '').replace(/\.(jpe?g|png|webp)$/i, '');
    $('pouzit-prava').textContent = `Zdroj: ${kredit || 'neuvedený'}. Licencia: ${licencia || 'neuvedená'}.`;
    ($('dlg-pouzit') as HTMLDialogElement).showModal();
  }
  $('form-pouzit').addEventListener('submit', (e) => {
    e.preventDefault();
    pracuj($('pouzit-ulozit') as HTMLButtonElement, 'Ukladám…', async () => {
      await api(`/api/koncept/${stav.pr}/obrazok`, 'POST', { typ: 'url', url: pouzivanaUrl, popisok: ($('pouzit-popisok') as HTMLTextAreaElement).value });
      ($('dlg-pouzit') as HTMLDialogElement).close();
      stav = await api(`/api/koncept/${stav.pr}`);
      vykresliObrazky();
      hlas('Obrázok je uložený.');
    });
  });

  // Zmena stavu obrázka zo zdroja: automatické zaradenie je len odporúčanie, rozhoduje editor.
  let menenaUrl = '';
  function otvorPrava(p: any) {
    menenaUrl = p.url;
    ($('prava-zaradenie') as HTMLSelectElement).value = p.zaradenie;
    ($('prava-kredit') as HTMLInputElement).value = p.kredit || '';
    ($('prava-licencia') as HTMLInputElement).value = p.licencia || '';
    ($('prava-dovod') as HTMLTextAreaElement).value = '';
    $('prava-auto').textContent = `Automatické posúdenie: ${p.automaticke_zaradenie || p.zaradenie}. ${p.automaticky_dovod || p.dovod}`;
    ($('dlg-prava') as HTMLDialogElement).showModal();
  }
  $('form-prava').addEventListener('submit', (e) => {
    e.preventDefault();
    pracuj($('prava-ulozit') as HTMLButtonElement, 'Ukladám…', async () => {
      await api(`/api/koncept/${stav.pr}/prava`, 'POST', {
        url: menenaUrl,
        zaradenie: ($('prava-zaradenie') as HTMLSelectElement).value,
        kredit: ($('prava-kredit') as HTMLInputElement).value,
        licencia: ($('prava-licencia') as HTMLInputElement).value,
        dovod: ($('prava-dovod') as HTMLTextAreaElement).value,
      });
      ($('dlg-prava') as HTMLDialogElement).close();
      stav = await api(`/api/koncept/${stav.pr}`);
      vykresliObrazky();
      hlas('Stav obrázka je zmenený.');
    });
  });
  for (const id of ['dlg-pouzit', 'dlg-prava']) {
    $(id).querySelector('.dlg-zrusit')!.addEventListener('click', () => ($(id) as HTMLDialogElement).close());
  }
  // Chyby počas uloženia sa ukazujú pod dialógom, preto ich treba zopakovať aj v ňom.
  new MutationObserver(() => {
    for (const d of document.querySelectorAll<HTMLElement>('.dlg-chyba')) d.textContent = $('hlasenie').classList.contains('chyba') ? $('hlasenie').textContent : '';
  }).observe($('hlasenie'), { childList: true, characterData: true, subtree: true, attributes: true });

  // Generovanie v dvoch krokoch: najprv ukázať prompt na úpravu, až potom odoslať.
  $('gen-ukaz').addEventListener('click', () => {
    ($('gen-prompt') as HTMLTextAreaElement).value ||= stav.sprava?.prompt_ilustracie || stav.sprava?.obrazky?.prompt_ilustracie || '';
    $('gen-krok2').hidden = false;
    $('gen-prompt').focus();
  });
  $('gen-zrusit').addEventListener('click', () => ($('gen-krok2').hidden = true));
  const generuj = (tl: HTMLButtonElement) =>
    pracuj(tl, 'Generujem…', async () => {
      const { obrazokB64 } = await api('/api/generuj', 'POST', { prompt: ($('gen-prompt') as HTMLTextAreaElement).value });
      vygenerovany = obrazokB64;
      ($('gen-obrazok') as HTMLImageElement).src = `data:image/jpeg;base64,${obrazokB64}`;
      $('gen-vysledok').hidden = false;
    });
  $('gen-odoslat').addEventListener('click', (e) => generuj(e.currentTarget as HTMLButtonElement));
  $('gen-znova').addEventListener('click', (e) => generuj(e.currentTarget as HTMLButtonElement));
  $('gen-zahodit').addEventListener('click', () => { vygenerovany = null; $('gen-vysledok').hidden = true; });
  $('gen-pouzit').addEventListener('click', (e) =>
    pracuj(e.currentTarget as HTMLButtonElement, 'Ukladám…', async () => {
      await api(`/api/koncept/${stav.pr}/obrazok`, 'POST', { typ: 'generovany', obrazokB64: vygenerovany, popisok: ($('gen-popisok') as HTMLInputElement).value });
      stav = await api(`/api/koncept/${stav.pr}`);
      vykresliObrazky();
      $('gen-vysledok').hidden = $('gen-krok2').hidden = true;
      hlas('Vygenerovaný obrázok je uložený.');
    }),
  );

  // ---------- factcheck a korektúra ----------

  function vykresliFactcheck(fc: any) {
    if (!fc) { $('fc-suhrn').textContent = 'Factcheck neprebehol.'; $('fc-nalezy').replaceChildren(); $('fc-tvrdenia').replaceChildren(); return; }
    $('fc-suhrn').replaceChildren(
      el('p', {}, fc.hodnotenie),
      el('p', { class: 'meta' }, (fc.kola ?? []).map((k: any) => `Kolo ${k.kolo}: ${k.potvrdenych}/${k.tvrdeni} potvrdených, ${k.chyb} chýb`).join(' · ')),
    );
    const nalezy = fc.otvorene_nalezy ?? [];
    $('fc-nalezy').replaceChildren(
      ...(nalezy.length ? nalezy.map((n: any) =>
        el('div', { class: `nalez ${n.zavaznost}` },
          el('span', { class: `znacka ${n.zavaznost}` }, n.zavaznost), ` ${n.povod}`,
          el('div', {}, el('strong', {}, n.text)), el('div', {}, n.komentar),
          n.navrh_opravy ? el('div', { class: 'meta' }, `Návrh: ${n.navrh_opravy}`) : '')) : [el('p', { class: 'meta' }, 'Žiadne.')]),
    );
    $('fc-tvrdenia').replaceChildren(
      el('tr', {}, ...['Tvrdenie', 'Verdikt', 'Zdroj', 'Úryvok zo zdroja', 'Komentár'].map((h) => el('th', {}, h))),
      ...(fc.tvrdenia ?? []).map((t: any) =>
        el('tr', {}, el('td', {}, t.text), el('td', {}, el('span', { class: `znacka ${t.verdikt}` }, t.verdikt)), el('td', {}, t.zdroj), el('td', {}, t.dokaz), el('td', {}, t.komentar))),
    );
  }

  function vykresliKorekturu(k: any) {
    if (!k) { $('kor-upravy').textContent = 'Korektúra neprebehla.'; $('kor-diff').textContent = ''; return; }
    $('kor-upravy').replaceChildren(
      ...(k.chyba ? [el('p', {}, k.chyba)] : []),
      ...(k.upravy?.length ? k.upravy.map((u: any) =>
        el('div', { class: 'nalez upozornenie' }, el('span', { class: `znacka ${u.stav}` }, u.stav), ` ${u.dovod}`,
          el('div', { class: 'meta' }, `„${u.povodne}“ → „${u.opravene}“${u.poznamka ? ` (${u.poznamka})` : ''}`))) : [el('p', { class: 'meta' }, 'Korektorka nenavrhla žiadne úpravy. Jazyk skontrolujte sami.')]),
    );
    $('kor-diff').replaceChildren(
      ...String(k.diff || 'Bez zmien.').split('\n').map((r) => el('div', { class: r.startsWith('+') ? 'plus' : r.startsWith('-') ? 'minus' : '' }, r || ' ')),
    );
  }

  // ---------- text ----------

  for (const id of ['titulok', 'perex', 'telo']) $(id).addEventListener('input', nahlad);
  $('form-text').addEventListener('submit', (e) => {
    e.preventDefault();
    if (stav.zverejneny && !confirm('Uložiť zmeny priamo na verejný web?')) return;
    pracuj($('ulozit-text') as HTMLButtonElement, 'Ukladám…', async () => {
      await api(adresa(), 'PUT', {
        titulok: hodnota('titulok'),
        perex: hodnota('perex'),
        telo: hodnota('telo'),
        sekcia: hodnota('sekcia'),
        tagy: hodnota('tagy').split(',').map((t) => t.trim()).filter(Boolean),
        zdroje: zdrojeZTextu(hodnota('zdroje')),
        ...(stav.zverejneny ? { oprava: hodnota('oprava') } : {}),
      });
      const bolZverejneny = stav.zverejneny;
      stav = await api(adresa());
      vykresli();
      hlas(bolZverejneny ? 'Zmeny sú uložené. Na webe sa objavia po zostavení, zhruba o minútu.' : 'Koncept je uložený.');
    });
  });

  // Stiahnutie zverejneného článku a jeho vrátenie.
  const zmenZverejnenie = (stiahnut: boolean) => (e: Event) => {
    const otazka = stiahnut ? `Stiahnuť článok „${stav.hlavicka.title}“ z verejného webu?` : `Vrátiť článok „${stav.hlavicka.title}“ na verejný web?`;
    if (!confirm(otazka)) return;
    pracuj(e.currentTarget as HTMLButtonElement, 'Ukladám…', async () => {
      await api(`${adresa()}/stiahnut`, 'POST', { stiahnut });
      stav = await api(adresa());
      vykresli();
      hlas(stiahnut ? 'Článok je stiahnutý. Z webu zmizne po zostavení, zhruba o minútu.' : 'Článok je vrátený. Na webe sa objaví po zostavení, zhruba o minútu.');
    });
  };
  $('stiahnut').addEventListener('click', zmenZverejnenie(true));
  $('vratit').addEventListener('click', zmenZverejnenie(false));

  // ---------- zverejnenie ----------

  function neulozene() {
    return Boolean(stav) && odtlacok() !== ulozenyOdtlacok;
  }

  function aktualizujPrekazky() {
    if (!stav) return;
    const p: string[] = [];
    if (stav.cakaNaObrazok) p.push('Článok nemá vybraný obrázok.');
    if (neulozene()) p.push('Text má neuložené zmeny.');
    const malo = (stav.hlavicka.zdroje ?? []).length < 2;
    const chyby = (stav.sprava?.factcheck?.otvorene_nalezy ?? []).filter((n: any) => n.zavaznost === 'chyba').length;
    $('prekazky').replaceChildren(...p.map((t) => el('li', {}, t)), ...(malo ? [el('li', { style: 'color:var(--pozor)' }, 'Článok uvádza len jeden zdroj. Redakčné zásady žiadajú aspoň dva.')] : []), ...(chyby ? [el('li', { style: 'color:var(--pozor)' }, `Factcheck má ${chyby} neuzavretý nález. Skontrolujte ho na karte Factcheck.`)] : []));
    ($('zverejnit') as HTMLButtonElement).disabled = p.length > 0 || !($('potvrdenie') as HTMLInputElement).checked;
  }
  $('potvrdenie').addEventListener('change', aktualizujPrekazky);
  for (const id of ['titulok', 'perex', 'telo', 'sekcia', 'tagy', 'zdroje']) $(id).addEventListener('input', aktualizujPrekazky);

  $('zverejnit').addEventListener('click', (e) => {
    if (!confirm(`Zverejniť článok „${stav.hlavicka.title}“ na verejnom webe?`)) return;
    pracuj(e.currentTarget as HTMLButtonElement, 'Zverejňujem…', async () => {
      const { clanok } = await api(`/api/koncept/${stav.pr}/zverejnit`, 'POST', { potvrdenie: true });
      zavriDetail();
      await nacitajZoznam();
      hlas(`Článok je zverejnený. Na webe sa objaví po zostavení, zhruba o minútu: ${clanok}`);
    });
  });
  $('zahodit').addEventListener('click', (e) => {
    if (!confirm('Zahodiť tento koncept? Pull request sa zavrie a vetva zmaže.')) return;
    pracuj(e.currentTarget as HTMLButtonElement, 'Zahadzujem…', async () => {
      await api(`/api/koncept/${stav.pr}/zahodit`, 'POST', {});
      zavriDetail();
      await nacitajZoznam();
      hlas('Koncept je zahodený.');
    });
  });

  // ---------- navigácia ----------

  function prepniKartu(nazov: string) {
    document.querySelectorAll<HTMLElement>('.karta-tl').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.karta === nazov)));
    document.querySelectorAll<HTMLElement>('.panel').forEach((p) => (p.hidden = p.dataset.panel !== nazov));
  }
  document.querySelectorAll<HTMLElement>('.karta-tl').forEach((t) => t.addEventListener('click', () => prepniKartu(t.dataset.karta!)));

  function zavriDetail() {
    stav = null;
    $('detail').hidden = true;
    $('zoznam').hidden = false;
    history.replaceState(null, '', location.pathname);
  }
  $('spat').addEventListener('click', () => { if (!neulozene() || confirm('Text má neuložené zmeny. Naozaj odísť?')) zavriDetail(); });
  $('obnovit').addEventListener('click', () => { zavriDetail(); nacitajZoznam(); });

  $('odhlasit').addEventListener('click', async () => {
    await fetch('/api/auth/odhlasit', { method: 'POST' });
    location.reload();
  });

  // Najprv zistiť, či je editor prihlásený. Bez prihlásenia sa ukáže len tlačidlo.
  const ja = await fetch('/api/ja');
  if (ja.ok) {
    $('kto').textContent = (await ja.json()).login;
    $('prihlaseny').hidden = false;
    $('redakcia-obsah').hidden = false;
    await nacitajZoznam();
    const hash = location.hash.slice(1);
    if (hash.startsWith('clanok/')) otvorZverejneny(hash.slice(7));
    else if (Number(hash)) otvor(Number(hash));
  } else if (ja.status === 401) {
    $('prihlasenie').hidden = false;
  } else {
    hlas((await ja.json().catch(() => ({}))).chyba || `Chyba ${ja.status}`, true);
  }
</script>
